[global]
repo1-type=s3
repo1-path={{ patroni_s3_prefix }}
repo1-s3-bucket={{ patroni_s3_bucket_name }}
repo1-s3-endpoint={{ patroni_s3_endpoint }}
repo1-storage-port={{ patroni_s3_port }}
repo1-s3-region={{ patroni_s3_region }}
repo1-s3-uri-style=path

repo1-s3-key={{ patroni_minio_key }}
repo1-s3-key-secret={{ patroni_minio_secret }}
repo1-storage-ca-file={{ patroni_ca_cert_dir }}/ca.crt
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass={{ patroni_repo_cipher_pass }}

repo1-retention-full=2

process-max=2
start-fast=y
log-level-console=info
log-level-file=detail

[{{ patroni_cluster_name }}]
pg1-path={{ patroni_postgres_data_dir }}
