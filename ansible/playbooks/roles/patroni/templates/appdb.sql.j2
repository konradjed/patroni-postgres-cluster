DO $do$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'app_user') THEN
    CREATE ROLE app_user LOGIN;
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'dumper') THEN
    CREATE ROLE dumper LOGIN;
  END IF;
END
$do$;

ALTER ROLE app_user WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION
  PASSWORD '{{ patroni_app_user_password }}';
ALTER ROLE dumper WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT pg_read_all_data TO dumper;

SELECT 'CREATE DATABASE {{ patroni_app_db_name }} OWNER postgres'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '{{ patroni_app_db_name }}')\gexec

REVOKE CONNECT ON DATABASE {{ patroni_app_db_name }} FROM PUBLIC;
GRANT CONNECT ON DATABASE {{ patroni_app_db_name }} TO app_user;
GRANT CONNECT ON DATABASE {{ patroni_app_db_name }} TO dumper;

\connect {{ patroni_app_db_name }}

REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO app_user;

CREATE TABLE IF NOT EXISTS public.ha_probe (
  probe_id    text PRIMARY KEY,
  client_name text NOT NULL,
  created_at  timestamptz NOT NULL DEFAULT clock_timestamp()
);

GRANT SELECT, INSERT ON public.ha_probe TO app_user;
