#!/bin/bash
set -euo pipefail

path="${1:?usage: patroni-require-volume <path> <expected-device>}"
expected="${2:?usage: patroni-require-volume <path> <expected-device>}"

if ! mountpoint -q "$path"; then
    echo "patroni: $path is not a mount point; refusing to start" >&2
    exit 1
fi

actual="$(findmnt -no SOURCE --mountpoint "$path")"

actual_device="$(readlink -e -- "$actual" || true)"
expected_device="$(readlink -e -- "$expected" || true)"

if [[ -z "$actual_device" ||
      -z "$expected_device" ||
      "$actual_device" != "$expected_device" ]]; then
    echo "patroni: $path is mounted from '${actual:-nothing}', expected '$expected'" >&2
    exit 1
fi