### Editing /etc/systemd/system/etcd.service.d/override.conf
[Unit]
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
RequiresMountsFor={{ patroni_etcd_data_dir }}

[Service]
ExecStartPre=/usr/local/sbin/patroni-require-volume {{ patroni_etcd_data_dir }} /dev/mapper/patroni-{{ patroni_etcd_volume_name }}
Restart=always
RestartSec=5