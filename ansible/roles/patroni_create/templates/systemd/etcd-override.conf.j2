### Editing /etc/systemd/system/etcd.service.d/override.conf
[Unit]
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=5
ExecStart=
ExecStart=/bin/bash -c "GOMAXPROCS=$(nproc) /usr/bin/etcd --config-file {{ patroni_create_vars_etcd_config_dir }}/etcd.conf.yaml"
