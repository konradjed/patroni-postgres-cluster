### Editing /etc/systemd/system/etcd.service.d/override.conf
[Unit]
Requires=patroni-mount-volumes.service
After=network-online.target patroni-mount-volumes.service
Wants=network-online.target
StartLimitIntervalSec=0
RequiresMountsFor={{ patroni_create_vars_etcd_data_dir }}

[Service]
ExecStartPre=/usr/local/sbin/patroni-require-volume {{ patroni_create_vars_etcd_data_dir }} {{ patroni_create_data_volumes | selectattr('path', 'equalto', patroni_create_vars_etcd_data_dir) | map(attribute='device') | first }}
Restart=always
RestartSec=5
