[Unit]
Description=Runners to orchestrate a high-availability PostgreSQL
Requires=etcd.service
After=network-online.target etcd.service
Wants=network-online.target

[Service]
Type=simple 
User=postgres
Group=postgres
RuntimeDirectory=patroni postgresql
RuntimeDirectoryMode=0700
ExecStart={{ patroni_create_vars_patroni_bin | quote }} {{ patroni_create_vars_patroni_config_yaml | quote }}
ExecReload=/bin/kill -s HUP $MAINPID 
KillMode=process 
TimeoutSec=30 
Restart={{ patroni_create_vars_patroni_restart_svc_type }}

[Install]
WantedBy=multi-user.target
