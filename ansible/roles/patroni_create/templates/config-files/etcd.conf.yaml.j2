name: '{{ inventory_hostname }}'
data-dir: {{ patroni_create_vars_etcd_data_dir }}

auto-compaction-mode: periodic
auto-compaction-retention: "{{ patroni_create_etcd_auto_compaction_retention }}"
quota-backend-bytes: {{ patroni_create_etcd_quota_backend_bytes }}
snapshot-count: {{ patroni_create_etcd_snapshot_count }}
heartbeat-interval: {{ patroni_create_etcd_heartbeat_interval }}
election-timeout: {{ patroni_create_etcd_election_timeout }}

initial-cluster-token: {{ patroni_create_pg_token }}
initial-cluster-state: new
initial-cluster: {% for host in groups[patroni_create_inventory_group] %}{{ host }}=https://{{ hostvars[host].ansible_host }}:2380{% if not loop.last %},{% endif %}{% endfor +%}

initial-advertise-peer-urls: https://{{ ansible_host }}:2380
listen-peer-urls: https://0.0.0.0:2380
advertise-client-urls: https://{{ ansible_host }}:2379
listen-client-urls: https://0.0.0.0:2379

peer-transport-security:
  trusted-ca-file: /etc/pki/ca-trust/source/anchors/patroni-intra-ca.crt
  client-cert-auth: true
  cert-file: {{ patroni_create_vars_etcd_ssl }}/etcd-{{ inventory_hostname }}.crt
  key-file: {{ patroni_create_vars_etcd_ssl }}/etcd-{{ inventory_hostname }}.key

client-transport-security:
  client-cert-auth: true
  trusted-ca-file: /etc/pki/ca-trust/source/anchors/patroni-intra-ca.crt
  cert-file: {{ patroni_create_vars_etcd_ssl }}/etcd-{{ inventory_hostname }}.crt
  key-file: {{ patroni_create_vars_etcd_ssl }}/etcd-{{ inventory_hostname }}.key

tls-min-version: TLS1.3
