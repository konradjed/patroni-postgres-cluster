[global]
repo1-type=s3
repo1-path={{ patroni_create_s3_prefix }}
repo1-s3-bucket={{ patroni_create_s3_bucket_name }}
repo1-s3-endpoint={{ patroni_create_s3_endpoint }}
repo1-storage-port={{ patroni_create_s3_port }}
repo1-s3-region={{ patroni_create_s3_region }}
repo1-s3-uri-style=path

repo1-storage-ca-file=/etc/pki/ca-trust/source/anchors/patroni-intra-ca.crt
repo1-cipher-type=aes-256-cbc


repo1-retention-full=2

process-max=2
start-fast=y
log-level-console=info
log-level-file=detail

[{{ patroni_create_cluster_name }}]
pg1-path={{ patroni_create_vars_postgres_data_dir }}
