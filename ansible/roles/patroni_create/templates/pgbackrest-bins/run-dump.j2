#!/usr/bin/env bash
set -euo pipefail

readonly GATE=/usr/local/lib/patroni/leader-gate

if "$GATE"; then
  :
else
  gate_status=$?
  case "$gate_status" in
    1) echo "Not the leader; no dump taken on this node."; exit 0 ;;
    *) echo "Refusing to run: leadership could not be determined." >&2; exit 1 ;;
  esac
fi

echo "Leader confirmed; dumping..."

exec /usr/local/libexec/patroni/pgback-wrapper
